# Streamlit Secrets Configuration Example
# Copy this file to secrets.toml and fill in your actual values
# secrets.toml is gitignored for security

[general]
# Single API key (simple setup)
GOOGLE_API_KEY = "your-gemini-api-key-here"

# OR: Multiple API keys for automatic rotation (comma-separated)
# GOOGLE_API_KEYS = "key1-here, key2-here, key3-here"

# OR: Multiple API keys as a list (TOML array format)
# GOOGLE_API_KEYS = ["key1-here", "key2-here", "key3-here"]

# Optional: Custom settings
# OPENAI_API_KEY = "your-openai-api-key-if-needed"

# For Streamlit Cloud deployment:
# 1. Go to your app settings
# 2. Navigate to "Secrets" section
# 3. Copy the contents of your secrets.toml file there
